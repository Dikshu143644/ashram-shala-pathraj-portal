{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/ai-test", "destination": "/ai-test/index.html" },
    { "source": "/ai-test/", "destination": "/ai-test/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**": {
      "maxDuration": 30
    }
  }
}
