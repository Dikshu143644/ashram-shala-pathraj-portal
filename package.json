{
  "name": "ashram-shala-pathraj",
  "version": "1.0.0",
  "type": "module",
  "description": "Shashkeey Madhyamik v Uchh Madhyamik Ashram Shala Pathraj - Management System",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --outfile=dist/server.js --format=esm --external:express --external:@google/genai",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "tsc --noEmit",
    "docker:build": "docker build -t ashram-shala-pathraj .",
    "docker:run": "docker run -p 3000:3000 --env-file .env ashram-shala-pathraj"
  },
  "dependencies": {
    "@google/genai": "^0.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "express": "^4.21.0",
    "lucide-react": "^0.460.0",
    "motion": "^11.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
