# Server
PORT=3000
NODE_ENV=production

# AI - Google Gemini (required for AI chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Voice - ElevenLabs (required for text-to-speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Database - Supabase (future: for real-time student data, attendance, hostel records)
# Once connected, the multi-agent system will query real data instead of using static prompts.
# The Attendance Agent will fetch live attendance records.
# The Academic Agent will pull real exam results and marks.
# The Hostel Agent will query bed allotment and mess attendance.
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Database - MongoDB (alternative to Supabase, if preferred)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ashramshala

# WhatsApp Integration (future: for parent notifications)
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Docker Registry
GHCR_TOKEN=your_github_token_here
